# ==========================================================================
# Multi-Platform Cryptocurrency Trading Hub — environment configuration
# Copy to `.env` and fill in real values. NEVER commit the real .env file.
# ==========================================================================

# --- Application ---
APP_ENV=development                 # development | staging | production
APP_DEBUG=true
APP_NAME="Crypto Trading Hub"
API_V1_PREFIX=/api/v1

# --- Security ---
# 32-byte urlsafe base64 key used to encrypt exchange API secrets at rest.
# Generate with:  python -m app.scripts.gen_keys
# To rotate, put the NEW key first and keep the old one until stored secrets
# have been re-encrypted:  MASTER_ENCRYPTION_KEY=<new>,<old>
MASTER_ENCRYPTION_KEY=
# HS256 signing secret for JWT access/refresh tokens (>= 32 chars random).
JWT_SECRET_KEY=
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14

# Auth hardening. When true, the refresh-token denylist and the per-account
# login throttle are backed by Redis (shared across replicas); otherwise they
# use an in-process store. Set true in multi-replica production.
USE_REDIS_AUTH_STORE=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# --- Trading safety ---
# When false, order placement is fully simulated (paper trading). Live orders
# are IMPOSSIBLE regardless of any per-request flag. This is the safe default.
ALLOW_LIVE_TRADING=false
# When true, live adapters connect to exchange TESTNET/sandbox endpoints only.
USE_EXCHANGE_TESTNET=true

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://cth:cth@localhost:5432/crypto_hub
# Tests override this to an in-memory SQLite database automatically.

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=120
